# ========================================
# DATABASE
# ========================================
DATABASE_URL="postgresql://postgres:password@localhost:5432/easyorder_partners"

# ========================================
# SERVER
# ========================================
PORT=3000
NODE_ENV=development

# ========================================
# LOGGING
# ========================================
LOG_LEVEL=info
WHATSAPP_LOG_LEVEL=error

# ========================================
# AUTHENTICATION & SECURITY
# ========================================
JWT_SECRET=your-secret-key-here
JWT_EXPIRATION=7d

# ========================================
# WHATSAPP / BAILEYS SERVICE
# ========================================
BAILEYS_URL=https://whatsapp-baileys.okcrm.mx
BAILEYS_API_KEY=T0Z612B-VYAWE4R5QPGD93NIX8SLM7HU
BAILEYS_FROM_PHONE=5218001234567

# Legacy/Alternative naming (for compatibility)
VITE_API_URL=https://whatsapp-baileys.okcrm.mx
VITE_API_KEY=T0Z612B-VYAWE4R5QPGD93NIX8SLM7HU

# ========================================
# ELEVENLABS (Voice AI)
# ========================================
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_AGENTS_URL=https://api.elevenlabs.io/v1/convai/agents
ELEVENLABS_SDR_AGENT_ID=your-sdr-agent-id
ELEVENLABS_QUALIFICATION_AGENT_ID=your-qualification-agent-id
ELEVENLABS_AGENT_PHONE_NUMBER_ID=your-phone-number-id

# ========================================
# DEMO FORM SERVICE (Agent Builder)
# ========================================
DEMO_FORM_SERVICE_URL=http://localhost:3001/api
AGENTS_CONFIG_KEY=your-agents-config-key

# ========================================
# REDIS (for queues and caching)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=

# ========================================
# CORS & SECURITY
# ========================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourdomain.com

# ========================================
# RATE LIMITING
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ========================================
# STRIPE (for coupon management)
# ========================================
STRIPE_API_KEY=sk_test_your-stripe-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# ========================================
# TWENTY CRM (optional integration)
# ========================================
TWENTY_API_URL=https://your-twenty-instance.com/api
TWENTY_API_KEY=your-twenty-api-key

# ========================================
# CALENDLY (optional integration)
# ========================================
CALENDLY_API_KEY=your-calendly-api-key
CALENDLY_WEBHOOK_SECRET=your-webhook-secret

# ========================================
# EMAIL SERVICE (optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@easyorder.com

# ========================================
# AWS S3 (for file uploads)
# ========================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=your-bucket-name

# ========================================
# SENTRY (error tracking - optional)
# ========================================
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ========================================
# ENVIRONMENT-SPECIFIC
# ========================================
# Development
DEV_DATABASE_URL=postgresql://postgres:password@localhost:5432/easyorder_dev

# Production
PROD_DATABASE_URL=postgresql://postgres:password@prod-host:5432/easyorder_prod
