// Prisma Schema para EasyOrder Partners API
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== USUARIOS Y AUTENTICACION ==========

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?   @map("password_hash")
  name          String
  role          UserRole  @default(PARTNER)
  emailVerified DateTime? @map("email_verified")
  image         String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  partner                 Partner?
  accounts                Account[]
  sessions                Session[]
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]

  @@index([email])
  @@index([role])
  @@map("users")
}

// ========== TOKENS DE AUTENTICACION ==========

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

enum UserRole {
  ADMIN
  PARTNER
  PENDING
}

// ========== PARTNER ==========

model Partner {
  id     String @id @default(uuid())
  userId String @unique @map("user_id")
  code   String @unique // Codigo unico: EO-ABC123

  type   PartnerType
  tier   PartnerTier   @default(REGISTERED)
  status PartnerStatus @default(PENDING)

  // Datos de empresa
  companyName String? @map("company_name")
  companyType String? @map("company_type")
  taxId       String? @map("tax_id") // RFC
  website     String?
  phone       String?

  // Direccion
  country String  @default("MX")
  state   String?
  city    String?
  address String?

  // Contacto adicional
  contactName  String? @map("contact_name")
  contactEmail String? @map("contact_email")
  contactPhone String? @map("contact_phone")

  // Comisiones
  commissionRate Decimal @default(0.15) @map("commission_rate") @db.Decimal(5, 4)
  paymentMethod  String? @map("payment_method")
  paymentDetails Json?   @map("payment_details")

  // Tracking
  referralLink    String  @unique @map("referral_link")
  totalLeads      Int     @default(0) @map("total_leads")
  totalDeals      Int     @default(0) @map("total_deals")
  totalRevenue    Decimal @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalCommission Decimal @default(0) @map("total_commission") @db.Decimal(12, 2)

  // Fechas
  approvedAt     DateTime? @map("approved_at")
  firstSaleAt    DateTime? @map("first_sale_at")
  lastActivityAt DateTime? @map("last_activity_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relaciones
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  leads        Lead[]
  deals        Deal[]
  commissions  Commission[]
  activities   Activity[]
  referredBy   Partner?     @relation("PartnerReferrals", fields: [referredById], references: [id])
  referredById String?      @map("referred_by_id")
  referrals    Partner[]    @relation("PartnerReferrals")
  prospects    LeadProspect[] // GeoInsights prospects
  
  // LMS relations
  enrollments    CourseEnrollment[]
  lessonProgress LessonProgress[]
  quizAttempts   QuizAttempt[]
  certificates   Certificate[]

  @@index([code])
  @@index([type])
  @@index([tier])
  @@index([status])
  @@index([createdAt])
  @@map("partners")
}

enum PartnerType {
  AFFILIATE
  REFERRAL
  RESELLER
  SOLUTIONS
  TECHNOLOGY
}

enum PartnerTier {
  REGISTERED
  SILVER
  GOLD
  ELITE
}

enum PartnerStatus {
  PENDING
  ACTIVE
  SUSPENDED
  INACTIVE
}

// ========== LEADS ==========

model Lead {
  id        String @id @default(uuid())
  partnerId String @map("partner_id")

  // Datos del lead
  businessName String @map("business_name")
  contactName  String @map("contact_name")
  email        String
  phone        String?

  // Detalles del negocio
  businessType  String?  @map("business_type")
  location      String?
  monthlyOrders String?  @map("monthly_orders")
  interests     String[]

  // Tracking UTM
  utmSource   String? @map("utm_source")
  utmMedium   String? @map("utm_medium")
  utmCampaign String? @map("utm_campaign")
  utmTerm     String? @map("utm_term")
  utmContent  String? @map("utm_content")
  landingPage String? @map("landing_page")
  referrer    String?

  // Estado
  status       LeadStatus @default(NEW)
  qualityScore Int?       @map("quality_score") // 1-100
  notes        String?    @db.Text

  // Valor estimado
  estimatedValue Decimal? @map("estimated_value") @db.Decimal(10, 2)
  estimatedMrr   Decimal? @map("estimated_mrr") @db.Decimal(10, 2)

  // Fechas
  contactedAt DateTime? @map("contacted_at")
  qualifiedAt DateTime? @map("qualified_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relaciones
  partner    Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deal       Deal?
  activities Activity[]

  @@index([partnerId])
  @@index([status])
  @@index([email])
  @@index([utmCampaign])
  @@index([createdAt])
  @@map("leads")
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  NEGOTIATION
  WON
  LOST
}

// ========== DEALS (Ventas Cerradas) ==========

model Deal {
  id        String @id @default(uuid())
  partnerId String @map("partner_id")
  leadId    String @unique @map("lead_id")

  // Cliente
  customerId   String? @map("customer_id") // ID en sistema EasyOrder
  businessName String  @map("business_name")

  // Plan y valor
  planType   String  @map("plan_type") // starter, growth, premium
  planPrice  Decimal @map("plan_price") @db.Decimal(10, 2) // MRR del plan
  setupFee   Decimal @default(0) @map("setup_fee") @db.Decimal(10, 2)
  totalValue Decimal @map("total_value") @db.Decimal(10, 2) // Valor total 12 meses

  // Comision
  commissionRate   Decimal @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal @map("commission_amount") @db.Decimal(10, 2)
  commissionPaid   Decimal @default(0) @map("commission_paid") @db.Decimal(10, 2)

  // Estado
  status DealStatus @default(PENDING)

  // Fechas
  closedAt    DateTime  @map("closed_at")
  activatedAt DateTime? @map("activated_at")
  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relaciones
  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lead        Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  commissions Commission[]

  @@index([partnerId])
  @@index([status])
  @@index([closedAt])
  @@map("deals")
}

enum DealStatus {
  PENDING
  ACTIVE
  CHURNED
}

// ========== COMISIONES ==========

model Commission {
  id        String @id @default(uuid())
  partnerId String @map("partner_id")
  dealId    String @map("deal_id")

  // Tipo y monto
  type     CommissionType
  amount   Decimal        @db.Decimal(10, 2)
  currency String         @default("MXN")

  // Periodo (para comisiones recurrentes)
  periodStart DateTime? @map("period_start")
  periodEnd   DateTime? @map("period_end")

  // Estado de pago
  status     CommissionStatus @default(PENDING)
  paidAt     DateTime?        @map("paid_at")
  paymentRef String?          @map("payment_ref")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  deal    Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@map("commissions")
}

enum CommissionType {
  SIGNUP_BONUS
  RECURRING
  BONUS
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

// ========== ACTIVIDADES ==========

model Activity {
  id        String @id @default(uuid())
  partnerId String @map("partner_id")
  leadId    String? @map("lead_id")

  type        ActivityType
  description String
  metadata    Json?

  createdAt DateTime @default(now()) @map("created_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lead    Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

enum ActivityType {
  PARTNER_REGISTERED
  PARTNER_APPROVED
  PARTNER_TIER_UPGRADE
  LEAD_CREATED
  LEAD_STATUS_CHANGED
  DEAL_CLOSED
  COMMISSION_EARNED
  COMMISSION_PAID
  LOGIN
  RESOURCE_DOWNLOADED
}

// ========== RECURSOS DE MARKETING ==========

model Resource {
  id String @id @default(uuid())

  name         String
  description  String?
  category     ResourceCategory
  type         String // pdf, pptx, docx, mp4, png
  url          String? // URL externa (opcional)
  thumbnailUrl String? @map("thumbnail_url")

  // Archivos subidos localmente
  fileName     String?  @map("file_name")
  fileSize     Int?     @map("file_size") // bytes
  mimeType     String?  @map("mime_type")
  storagePath  String?  @map("storage_path")

  // Permisos
  minTier      PartnerTier   @default(REGISTERED) @map("min_tier")
  partnerTypes PartnerType[] @map("partner_types")

  // Metadata
  tags         String[]
  downloads    Int @default(0)
  viewCount    Int @default(0) @map("view_count")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([minTier])
  @@index([isActive])
  @@map("resources")
}

enum ResourceCategory {
  SALES_DECK
  ONE_PAGER
  EMAIL_TEMPLATE
  SOCIAL_MEDIA
  VIDEO
  CASE_STUDY
  PRICE_LIST
  BRAND_ASSETS
  CONTRACT_TEMPLATE
  OTHER
}

// ========== CONFIGURACION DEL PROGRAMA ==========

model ProgramConfig {
  id String @id @default(uuid())

  key         String  @unique
  value       Json
  description String?

  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("program_config")
}

// ========== NextAuth Tables ==========

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ========== API KEYS ==========

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?   @db.Text
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

// ========== GEOINSIGHTS - ESTABLECIMIENTOS DENUE ==========

model Establishment {
  id           String  @id // ID DENUE original
  clee         String? @unique // Clave unica INEGI
  name         String  // nom_estab
  businessName String? @map("business_name") // raz_social
  activityCode String  @map("activity_code") // codigo_act (SCIAN)
  activityName String  @map("activity_name") // nombre_act

  // Personal
  employeeRange String? @map("employee_range") // per_ocu

  // Direccion completa
  streetType    String? @map("street_type") // tipo_vial
  streetName    String? @map("street_name") // nom_vial
  exteriorNum   String? @map("exterior_num") // numero_ext
  interiorNum   String? @map("interior_num") // numero_int
  neighborhood  String? // nomb_asent
  postalCode    String? @map("postal_code") // cod_postal

  // Ubicacion geografica
  stateCode        String @map("state_code") // cve_ent
  stateName        String @map("state_name") // entidad
  municipalityCode String @map("municipality_code") // cve_mun
  municipalityName String @map("municipality_name") // municipio
  localityCode     String? @map("locality_code") // cve_loc
  localityName     String? @map("locality_name") // localidad
  ageb             String? // Area geoestadistica basica
  block            String? // manzana

  // Coordenadas GPS
  latitude  Float
  longitude Float

  // Contacto
  phone   String?
  email   String?
  website String?

  // Metadata
  establishmentType String? @map("establishment_type") // tipoUniEco (Fijo/Semifijo)
  addedDate         String? @map("added_date") // fecha_alta

  // Relaciones
  prospects  LeadProspect[]
  enrichment EstablishmentEnrichment?

  // Indices para busquedas geograficas rapidas
  @@index([stateCode])
  @@index([municipalityCode])
  @@index([activityCode])
  @@index([latitude, longitude])
  @@index([postalCode])
  @@map("establishments")
}

// ========== ENRIQUECIMIENTO DE ESTABLECIMIENTOS ==========

// Nivel de enriquecimiento del establecimiento
enum EstablishmentLevel {
  ESTABLISHMENT // Solo datos DENUE base
  CONTACT       // Tiene phone/email/website (dato DENUE)
  PROSPECT      // Tiene info del tomador de decisiones
  LEAD          // Tiene cualificacion completa (intent/fear/pain/desire)
  CLIENT        // Lead que ya realizo una compra
}

// Enriquecimiento de establecimientos (datos adicionales capturados por partners)
model EstablishmentEnrichment {
  id              String @id @default(uuid())
  establishmentId String @unique @map("establishment_id")

  // Informacion del tomador de decisiones (Nivel: Prospecto)
  decisionMakerName     String? @map("decision_maker_name")
  decisionMakerPosition String? @map("decision_maker_position") // dueno, gerente, encargado
  decisionMakerPhone    String? @map("decision_maker_phone")
  decisionMakerWhatsApp String? @map("decision_maker_whatsapp")
  decisionMakerEmail    String? @map("decision_maker_email")

  // Informacion de cualificacion (Nivel: Lead)
  intent String? @db.Text // Intencion/interes demostrado en el producto
  fear   String? @db.Text // Miedos o preocupaciones del prospecto
  pain   String? @db.Text // Dolor/problemas actuales que enfrenta
  desire String? @db.Text // Lo que desea solucionar o lograr

  // Informacion de cliente (Nivel: Client)
  purchaseDate     DateTime? @map("purchase_date")     // Fecha de primera compra
  productPurchased String?   @map("product_purchased") // Producto/plan adquirido
  purchaseAmount   Decimal?  @map("purchase_amount") @db.Decimal(10, 2) // Monto de compra
  clientSince      DateTime? @map("client_since")      // Fecha desde que es cliente
  clientStatus     String?   @map("client_status")     // activo, inactivo, churned
  clientNotes      String?   @map("client_notes") @db.Text // Notas adicionales del cliente

  // Nivel calculado automaticamente
  level EstablishmentLevel @default(ESTABLISHMENT)

  // Metadata de quien enriquecio los datos
  enrichedBy    String?   @map("enriched_by") // partnerId que enriquecio
  enrichedAt    DateTime? @map("enriched_at")
  lastUpdatedBy String?   @map("last_updated_by")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relacion con el establecimiento
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@index([level])
  @@index([establishmentId])
  @@index([enrichedBy])
  @@map("establishment_enrichments")
}

// ========== PROSPECTS DESDE DENUE ==========

model LeadProspect {
  id              String @id @default(uuid())
  establishmentId String @map("establishment_id")
  partnerId       String? @map("partner_id")

  status   ProspectStatus @default(AVAILABLE)
  priority Int            @default(0) // Score de prioridad 0-100

  // Seguimiento
  assignedAt  DateTime? @map("assigned_at")
  contactedAt DateTime? @map("contacted_at")
  convertedAt DateTime? @map("converted_at")

  notes String? @db.Text

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)
  partner       Partner?      @relation(fields: [partnerId], references: [id], onDelete: SetNull)

  @@index([partnerId])
  @@index([status])
  @@index([establishmentId])
  @@map("lead_prospects")
}

enum ProspectStatus {
  AVAILABLE
  ASSIGNED
  CONTACTED
  CONVERTED
  NOT_INTERESTED
  INVALID
}

// ========== ZONAS GEOGRAFICAS ==========

model GeoZone {
  id   String   @id @default(uuid())
  name String
  type ZoneType

  // Codigos de referencia (para states/municipalities)
  stateCode        String? @map("state_code")
  municipalityCode String? @map("municipality_code")

  // Geometria GeoJSON para zonas custom
  geometry Json?

  // Metricas agregadas
  totalEstablishments Int   @default(0) @map("total_establishments")
  totalProspects      Int   @default(0) @map("total_prospects")
  assignedProspects   Int   @default(0) @map("assigned_prospects")
  convertedProspects  Int   @default(0) @map("converted_prospects")
  conversionRate      Float @default(0) @map("conversion_rate")

  // Centro de la zona (para centrar el mapa)
  centerLat Float? @map("center_lat")
  centerLng Float? @map("center_lng")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([stateCode])
  @@index([municipalityCode])
  @@map("geo_zones")
}

enum ZoneType {
  STATE
  MUNICIPALITY
  CUSTOM
}

// ========== NOTIFICACIONES ==========

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

enum NotificationType {
  LEAD_NEW
  LEAD_STATUS_CHANGED
  DEAL_CLOSED
  COMMISSION_APPROVED
  COMMISSION_PAID
  PARTNER_APPROVED
  PARTNER_TIER_UPGRADE
  SYSTEM
}

// ========== PLANTILLAS DE EMAIL ==========

model EmailTemplate {
  id        String  @id @default(uuid())
  name      String  @unique
  subject   String
  htmlBody  String  @map("html_body") @db.Text
  textBody  String  @map("text_body") @db.Text
  variables Json    // Variables disponibles para el template
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

// ========== SISTEMA LMS (CAPACITACIÓN) ==========

model Course {
  id           String           @id @default(uuid())
  title        String
  slug         String           @unique
  description  String           @db.Text
  thumbnailUrl String?          @map("thumbnail_url")
  duration     Int              // minutos totales estimados
  difficulty   CourseDifficulty
  minTier      PartnerTier      @default(REGISTERED) @map("min_tier")
  partnerTypes PartnerType[]    @map("partner_types")
  isPublished  Boolean          @default(false) @map("is_published")
  order        Int              @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lessons      Lesson[]
  enrollments  CourseEnrollment[]
  certificates Certificate[]

  @@index([slug])
  @@index([isPublished])
  @@map("courses")
}

enum CourseDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model Lesson {
  id          String  @id @default(uuid())
  courseId    String  @map("course_id")
  title       String
  slug        String
  description String?
  content     String  @db.Text // Markdown
  videoUrl    String? @map("video_url") // YouTube/Vimeo embed
  duration    Int     // minutos
  order       Int

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  course   Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes  Quiz[]
  progress LessonProgress[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@map("lessons")
}

model Quiz {
  id           String @id @default(uuid())
  lessonId     String @map("lesson_id")
  title        String
  passingScore Int    @default(70) @map("passing_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lesson    Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions QuizQuestion[]
  attempts  QuizAttempt[]

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String  @map("quiz_id")
  question      String
  options       Json    // [{id, text}]
  correctOption String  @map("correct_option")
  explanation   String?
  order         Int

  quiz Quiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  partnerId   String           @map("partner_id")
  courseId    String           @map("course_id")
  status      EnrollmentStatus @default(IN_PROGRESS)
  progress    Int              @default(0) // porcentaje 0-100
  startedAt   DateTime         @default(now()) @map("started_at")
  completedAt DateTime?        @map("completed_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([partnerId, courseId])
  @@index([partnerId])
  @@index([courseId])
  @@map("course_enrollments")
}

enum EnrollmentStatus {
  IN_PROGRESS
  COMPLETED
  EXPIRED
}

model LessonProgress {
  id          String    @id @default(uuid())
  partnerId   String    @map("partner_id")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  watchTime   Int       @default(0) @map("watch_time") // segundos

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  lesson  Lesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([partnerId, lessonId])
  @@index([partnerId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  partnerId   String   @map("partner_id")
  quizId      String   @map("quiz_id")
  score       Int
  passed      Boolean
  answers     Json     // {questionId: answerId}
  attemptedAt DateTime @default(now()) @map("attempted_at")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  quiz    Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Certificate {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  courseId  String   @map("course_id")
  code      String   @unique // Código verificable
  issuedAt  DateTime @default(now()) @map("issued_at")
  pdfUrl    String?  @map("pdf_url")

  partner Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  course  Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([partnerId, courseId])
  @@index([code])
  @@map("certificates")
}
