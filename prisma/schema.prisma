generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                      String                   @id @default(uuid())
  email                   String                   @unique
  passwordHash            String?                  @map("password_hash")
  name                    String
  role                    UserRole                 @default(PARTNER)
  emailVerified           DateTime?                @map("email_verified")
  image                   String?
  createdAt               DateTime                 @default(now()) @map("created_at")
  updatedAt               DateTime                 @updatedAt @map("updated_at")
  accounts                Account[]
  emailVerificationTokens EmailVerificationToken[]
  notifications           Notification[]
  partner                 Partner?
  passwordResetTokens     PasswordResetToken[]
  sessions                Session[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  token     String    @unique
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@map("email_verification_tokens")
}

model Partner {
  id                    String                 @id @default(uuid())
  userId                String                 @unique @map("user_id")
  code                  String                 @unique
  type                  PartnerType
  tier                  PartnerTier            @default(REGISTERED)
  status                PartnerStatus          @default(PENDING)
  companyName           String?                @map("company_name")
  companyType           String?                @map("company_type")
  taxId                 String?                @map("tax_id")
  website               String?
  phone                 String?
  country               String                 @default("MX")
  state                 String?
  city                  String?
  address               String?
  contactName           String?                @map("contact_name")
  contactEmail          String?                @map("contact_email")
  contactPhone          String?                @map("contact_phone")
  commissionRate        Decimal                @default(0.15) @map("commission_rate") @db.Decimal(5, 4)
  paymentMethod         String?                @map("payment_method")
  paymentDetails        Json?                  @map("payment_details")
  referralLink          String                 @unique @map("referral_link")
  totalLeads            Int                    @default(0) @map("total_leads")
  totalDeals            Int                    @default(0) @map("total_deals")
  totalRevenue          Decimal                @default(0) @map("total_revenue") @db.Decimal(12, 2)
  totalCommission       Decimal                @default(0) @map("total_commission") @db.Decimal(12, 2)
  approvedAt            DateTime?              @map("approved_at")
  firstSaleAt           DateTime?              @map("first_sale_at")
  lastActivityAt        DateTime?              @map("last_activity_at")
  createdAt             DateTime               @default(now()) @map("created_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")
  referredById          String?                @map("referred_by_id")
  activities            Activity[]
  callLeads             CallLead[]
  certificates          Certificate[]
  commissions           Commission[]
  enrollments           CourseEnrollment[]
  deals                 Deal[]
  establishmentMeetings EstablishmentMeeting[]
  prospects             LeadProspect[]
  leads                 Lead[]
  lessonProgress        LessonProgress[]
  referredBy            Partner?               @relation("PartnerReferrals", fields: [referredById], references: [id])
  referrals             Partner[]              @relation("PartnerReferrals")
  user                  User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  quizAttempts          QuizAttempt[]
  referralCampaigns     ReferralCampaign[]

  @@index([code])
  @@index([type])
  @@index([tier])
  @@index([status])
  @@index([createdAt])
  @@map("partners")
}

model Lead {
  id             String     @id @default(uuid())
  partnerId      String     @map("partner_id")
  businessName   String     @map("business_name")
  contactName    String     @map("contact_name")
  email          String
  phone          String?
  businessType   String?    @map("business_type")
  location       String?
  monthlyOrders  String?    @map("monthly_orders")
  interests      String[]
  utmSource      String?    @map("utm_source")
  utmMedium      String?    @map("utm_medium")
  utmCampaign    String?    @map("utm_campaign")
  utmTerm        String?    @map("utm_term")
  utmContent     String?    @map("utm_content")
  landingPage    String?    @map("landing_page")
  referrer       String?
  status         LeadStatus @default(NEW)
  qualityScore   Int?       @map("quality_score")
  notes          String?
  estimatedValue Decimal?   @map("estimated_value") @db.Decimal(10, 2)
  estimatedMrr   Decimal?   @map("estimated_mrr") @db.Decimal(10, 2)
  contactedAt    DateTime?  @map("contacted_at")
  qualifiedAt    DateTime?  @map("qualified_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")
  activities     Activity[]
  deal           Deal?
  partner        Partner    @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([email])
  @@index([utmCampaign])
  @@index([createdAt])
  @@map("leads")
}

model Deal {
  id               String       @id @default(uuid())
  partnerId        String       @map("partner_id")
  leadId           String       @unique @map("lead_id")
  customerId       String?      @map("customer_id")
  businessName     String       @map("business_name")
  planType         String       @map("plan_type")
  planPrice        Decimal      @map("plan_price") @db.Decimal(10, 2)
  setupFee         Decimal      @default(0) @map("setup_fee") @db.Decimal(10, 2)
  totalValue       Decimal      @map("total_value") @db.Decimal(10, 2)
  commissionRate   Decimal      @map("commission_rate") @db.Decimal(5, 4)
  commissionAmount Decimal      @map("commission_amount") @db.Decimal(10, 2)
  commissionPaid   Decimal      @default(0) @map("commission_paid") @db.Decimal(10, 2)
  status           DealStatus   @default(PENDING)
  closedAt         DateTime     @map("closed_at")
  activatedAt      DateTime?    @map("activated_at")
  cancelledAt      DateTime?    @map("cancelled_at")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  commissions      Commission[]
  lead             Lead         @relation(fields: [leadId], references: [id], onDelete: Cascade)
  partner          Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([closedAt])
  @@map("deals")
}

model Commission {
  id          String           @id @default(uuid())
  partnerId   String           @map("partner_id")
  dealId      String           @map("deal_id")
  type        CommissionType
  amount      Decimal          @db.Decimal(10, 2)
  currency    String           @default("MXN")
  periodStart DateTime?        @map("period_start")
  periodEnd   DateTime?        @map("period_end")
  status      CommissionStatus @default(PENDING)
  paidAt      DateTime?        @map("paid_at")
  paymentRef  String?          @map("payment_ref")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  deal        Deal             @relation(fields: [dealId], references: [id], onDelete: Cascade)
  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([status])
  @@index([createdAt])
  @@map("commissions")
}

model Activity {
  id          String       @id @default(uuid())
  partnerId   String       @map("partner_id")
  leadId      String?      @map("lead_id")
  type        ActivityType
  description String
  metadata    Json?
  createdAt   DateTime     @default(now()) @map("created_at")
  lead        Lead?        @relation(fields: [leadId], references: [id])
  partner     Partner      @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([type])
  @@index([createdAt])
  @@map("activities")
}

model Resource {
  id           String           @id @default(uuid())
  name         String
  description  String?
  category     ResourceCategory
  type         String
  url          String?
  thumbnailUrl String?          @map("thumbnail_url")
  fileName     String?          @map("file_name")
  fileSize     Int?             @map("file_size")
  mimeType     String?          @map("mime_type")
  storagePath  String?          @map("storage_path")
  minTier      PartnerTier      @default(REGISTERED) @map("min_tier")
  partnerTypes PartnerType[]    @map("partner_types")
  tags         String[]
  downloads    Int              @default(0)
  viewCount    Int              @default(0) @map("view_count")
  isActive     Boolean          @default(true) @map("is_active")
  createdAt    DateTime         @default(now()) @map("created_at")
  updatedAt    DateTime         @updatedAt @map("updated_at")

  @@index([category])
  @@index([minTier])
  @@index([isActive])
  @@map("resources")
}

model ProgramConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       Json
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("program_config")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model ApiKey {
  id          String    @id @default(uuid())
  key         String    @unique
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  lastUsedAt  DateTime? @map("last_used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([key])
  @@index([isActive])
  @@map("api_keys")
}

model EstablishmentEnrichment {
  id                    String             @id @default(uuid())
  establishmentId       String             @unique @map("establishment_id")
  decisionMakerName     String?            @map("decision_maker_name")
  decisionMakerPosition String?            @map("decision_maker_position")
  decisionMakerPhone    String?            @map("decision_maker_phone")
  decisionMakerWhatsApp String?            @map("decision_maker_whatsapp")
  decisionMakerEmail    String?            @map("decision_maker_email")
  intent                String?
  fear                  String?
  pain                  String?
  desire                String?
  level                 EstablishmentLevel @default(ESTABLISHMENT)
  enrichedBy            String?            @map("enriched_by")
  enrichedAt            DateTime?          @map("enriched_at")
  lastUpdatedBy         String?            @map("last_updated_by")
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")
  clientNotes           String?            @map("client_notes")
  clientSince           DateTime?          @map("client_since")
  clientStatus          String?            @map("client_status")
  productPurchased      String?            @map("product_purchased")
  purchaseAmount        Decimal?           @map("purchase_amount") @db.Decimal(10, 2)
  purchaseDate          DateTime?          @map("purchase_date")
  callSummary           String?            @map("call_summary")
  strategy              String?            @db.VarChar(10)
  callAttempts          Int?               @default(1) @map("call_attempts")
  callDurationSeconds   Int?               @default(0) @map("call_duration_seconds")
  callStatus            String?            @map("call_status") @db.VarChar(20)
  enrichmentStatus      String?            @map("enrichment_status") @db.VarChar(30)
  gatekeeperInfo        Json?              @map("gatekeeper_info")
  bestCallTime          String?            @map("best_call_time") @db.VarChar(50)
  establishmentData     Json?              @map("establishment_data")

  @@index([level])
  @@index([establishmentId])
  @@index([enrichedBy])
  @@index([enrichmentStatus])
  @@index([strategy])
  @@index([callStatus])
  @@map("establishment_enrichments")
}

model RestaurantProfile {
  id              String    @id @default(uuid())
  establishmentId String    @unique @map("establishment_id")
  leadId          String?   @map("lead_id")
  restaurantId    Int?      @map("restaurant_id")
  direccionId     Int?      @map("direccion_id")
  businessName    String    @map("business_name")
  cuisineType     String?   @map("cuisine_type")
  contactPhone    String?   @map("contact_phone")
  contactEmail    String?   @map("contact_email")
  contactWhatsapp String?   @map("contact_whatsapp")
  timezone        String?
  address         Json?
  logoUrl         String?   @map("logo_url")
  step1Completed  Boolean   @default(false) @map("step1_completed")
  step2Completed  Boolean   @default(false) @map("step2_completed")
  step3Completed  Boolean   @default(false) @map("step3_completed")
  provisionStatus String    @default("pending") @map("provision_status")
  provisionedAt   DateTime? @map("provisioned_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([leadId])
  @@index([restaurantId])
  @@index([provisionStatus])
  @@map("restaurant_profiles")
}

model SdrInteraction {
  id                  String   @id @default(uuid())
  establishmentId     String   @map("establishment_id")
  callStatus          String?  @map("call_status") @db.VarChar(30)
  enrichmentStatus    String?  @map("enrichment_status") @db.VarChar(30)
  decisionMakerFound  Boolean  @default(false) @map("decision_maker_found")
  decisionMakerName   String?  @map("decision_maker_name")
  decisionMakerRole   String?  @map("decision_maker_role")
  callSummary         String?  @map("call_summary")
  callDurationSeconds Int?     @map("call_duration_seconds")
  attemptNumber       Int      @default(1) @map("attempt_number")
  strategy            String?  @db.VarChar(10)
  gatekeeperInfo      Json?    @map("gatekeeper_info")
  twilioCallSid       String?  @map("twilio_call_sid") @db.VarChar(50)
  createdAt           DateTime @default(now()) @map("created_at")
  agentConfigId       String?  @map("agent_config_id") @db.Uuid

  @@index([establishmentId])
  @@index([callStatus])
  @@index([enrichmentStatus])
  @@index([strategy])
  @@index([decisionMakerFound])
  @@index([createdAt])
  @@index([agentConfigId])
  @@map("sdr_interactions")
}

model LeadProspect {
  id              String         @id @default(uuid())
  establishmentId String         @map("establishment_id")
  partnerId       String?        @map("partner_id")
  status          ProspectStatus @default(AVAILABLE)
  priority        Int            @default(0)
  assignedAt      DateTime?      @map("assigned_at")
  contactedAt     DateTime?      @map("contacted_at")
  convertedAt     DateTime?      @map("converted_at")
  notes           String?
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")
  partner         Partner?       @relation(fields: [partnerId], references: [id])

  @@index([partnerId])
  @@index([status])
  @@index([establishmentId])
  @@map("lead_prospects")
}

model GeoZone {
  id                  String   @id @default(uuid())
  name                String
  type                ZoneType
  stateCode           String?  @map("state_code")
  municipalityCode    String?  @map("municipality_code")
  geometry            Json?
  totalEstablishments Int      @default(0) @map("total_establishments")
  totalProspects      Int      @default(0) @map("total_prospects")
  assignedProspects   Int      @default(0) @map("assigned_prospects")
  convertedProspects  Int      @default(0) @map("converted_prospects")
  conversionRate      Float    @default(0) @map("conversion_rate")
  centerLat           Float?   @map("center_lat")
  centerLng           Float?   @map("center_lng")
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([stateCode])
  @@index([municipalityCode])
  @@map("geo_zones")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  data      Json?
  read      Boolean          @default(false)
  readAt    DateTime?        @map("read_at")
  createdAt DateTime         @default(now()) @map("created_at")
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String   @unique
  subject   String
  htmlBody  String   @map("html_body")
  textBody  String   @map("text_body")
  variables Json
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("email_templates")
}

model Course {
  id           String             @id @default(uuid())
  title        String
  slug         String             @unique
  description  String
  thumbnailUrl String?            @map("thumbnail_url")
  duration     Int
  difficulty   CourseDifficulty
  minTier      PartnerTier        @default(REGISTERED) @map("min_tier")
  partnerTypes PartnerType[]      @map("partner_types")
  isPublished  Boolean            @default(false) @map("is_published")
  order        Int                @default(0)
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  certificates Certificate[]
  enrollments  CourseEnrollment[]
  lessons      Lesson[]

  @@index([slug])
  @@index([isPublished])
  @@map("courses")
}

model Lesson {
  id          String           @id @default(uuid())
  courseId    String           @map("course_id")
  title       String
  slug        String
  description String?
  content     String
  videoUrl    String?          @map("video_url")
  duration    Int
  order       Int
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  progress    LessonProgress[]
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  quizzes     Quiz[]

  @@unique([courseId, slug])
  @@index([courseId])
  @@map("lessons")
}

model Quiz {
  id           String         @id @default(uuid())
  lessonId     String         @map("lesson_id")
  title        String
  passingScore Int            @default(70) @map("passing_score")
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  attempts     QuizAttempt[]
  questions    QuizQuestion[]
  lesson       Lesson         @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("quizzes")
}

model QuizQuestion {
  id            String  @id @default(uuid())
  quizId        String  @map("quiz_id")
  question      String
  options       Json
  correctOption String  @map("correct_option")
  explanation   String?
  order         Int
  quiz          Quiz    @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@map("quiz_questions")
}

model CourseEnrollment {
  id          String           @id @default(uuid())
  partnerId   String           @map("partner_id")
  courseId    String           @map("course_id")
  status      EnrollmentStatus @default(IN_PROGRESS)
  progress    Int              @default(0)
  startedAt   DateTime         @default(now()) @map("started_at")
  completedAt DateTime?        @map("completed_at")
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, courseId])
  @@index([partnerId])
  @@index([courseId])
  @@map("course_enrollments")
}

model LessonProgress {
  id          String    @id @default(uuid())
  partnerId   String    @map("partner_id")
  lessonId    String    @map("lesson_id")
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  watchTime   Int       @default(0) @map("watch_time")
  lesson      Lesson    @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  partner     Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, lessonId])
  @@index([partnerId])
  @@index([lessonId])
  @@map("lesson_progress")
}

model QuizAttempt {
  id          String   @id @default(uuid())
  partnerId   String   @map("partner_id")
  quizId      String   @map("quiz_id")
  score       Int
  passed      Boolean
  answers     Json
  attemptedAt DateTime @default(now()) @map("attempted_at")
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  quiz        Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([partnerId])
  @@index([quizId])
  @@map("quiz_attempts")
}

model Certificate {
  id        String   @id @default(uuid())
  partnerId String   @map("partner_id")
  courseId  String   @map("course_id")
  code      String   @unique
  issuedAt  DateTime @default(now()) @map("issued_at")
  pdfUrl    String?  @map("pdf_url")
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  partner   Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, courseId])
  @@index([code])
  @@map("certificates")
}

model ReferralCampaign {
  id           String   @id @default(uuid())
  partnerId    String   @map("partner_id")
  name         String
  utmSource    String   @map("utm_source")
  utmMedium    String   @map("utm_medium")
  utmCampaign  String   @map("utm_campaign")
  utmTerm      String?  @map("utm_term")
  utmContent   String?  @map("utm_content")
  fullLink     String   @map("full_link")
  shortLink    String?  @map("short_link")
  clicks       Int      @default(0)
  uniqueClicks Int      @default(0) @map("unique_clicks")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  partner      Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([partnerId, utmCampaign])
  @@index([partnerId])
  @@index([utmCampaign])
  @@index([isActive])
  @@map("referral_campaigns")
}

model EstablishmentMeeting {
  id               String    @id @default(uuid())
  establishmentId  String    @map("establishment_id")
  partnerId        String    @map("partner_id")
  meetingScheduled Boolean   @default(false) @map("meeting_scheduled")
  meetingDate      DateTime? @map("meeting_date")
  meetingLink      String?   @map("meeting_link")
  notes            String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  calendlyEventUri String?   @map("calendly_event_uri")
  partner          Partner   @relation(fields: [partnerId], references: [id], onDelete: Cascade)

  @@unique([establishmentId, partnerId])
  @@index([partnerId])
  @@index([establishmentId])
  @@index([meetingScheduled])
  @@index([meetingDate])
  @@map("establishment_meetings")
}

model CallLead {
  id                   String    @id @default(uuid())
  fullName             String    @map("full_name")
  phone                String
  email                String?
  establishmentId      String?   @map("establishment_id")
  preferredTime        String    @default("now") @map("preferred_time")
  scheduledAt          DateTime? @map("scheduled_at")
  callStatus           String    @default("pending") @map("call_status")
  callSummary          String?   @map("call_summary")
  callTranscript       Json?     @map("call_transcript")
  callDurationSeconds  Int?      @map("call_duration_seconds")
  qualificationScore   String?   @map("qualification_score")
  intentScore          Int?      @map("intent_score")
  qualificationDetails Json?     @map("qualification_details")
  intent               String?
  fear                 String?
  pain                 String?
  desire               String?
  nextAction           String?   @map("next_action")
  nextActionDate       DateTime? @map("next_action_date")
  bookingMethod        String?   @map("booking_method")
  convertedToLeadId    String?   @map("converted_to_lead_id")
  partnerId            String?   @map("partner_id")
  representativeName   String?   @map("representative_name")
  source               String    @default("sales_qualification")
  utmData              Json?     @map("utm_data")
  twilioCallSid        String?   @map("twilio_call_sid")
  calledAt             DateTime? @map("called_at")
  createdAt            DateTime  @default(now()) @map("created_at")
  updatedAt            DateTime  @updatedAt @map("updated_at")
  agentConfigId        String?   @map("agent_config_id") @db.Uuid
  partner              Partner?  @relation(fields: [partnerId], references: [id])

  @@index([callStatus])
  @@index([phone])
  @@index([qualificationScore])
  @@index([establishmentId])
  @@index([partnerId])
  @@index([createdAt(sort: Desc)])
  @@index([agentConfigId])
  @@map("call_leads")
}

model TwentySyncState {
  id                      String    @id @default(uuid())
  establishmentId         String    @unique @map("establishment_id")
  twentyEstablecimientoId String?   @map("twenty_establecimiento_id")
  twentyContactoId        String?   @map("twenty_contacto_id")
  twentyProspectoId       String?   @map("twenty_prospecto_id")
  twentyOpportunityId     String?   @map("twenty_opportunity_id")
  twentyClienteId         String?   @map("twenty_cliente_id")
  lastSyncedLevel         String?   @map("last_synced_level")
  lastSyncedAt            DateTime? @map("last_synced_at")
  lastError               String?   @map("last_error")
  lastErrorAt             DateTime? @map("last_error_at")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@index([twentyEstablecimientoId])
  @@index([twentyOpportunityId])
  @@index([lastSyncedLevel])
  @@map("twenty_sync_states")
}

model TwentySyncJob {
  id              String              @id @default(uuid())
  establishmentId String              @map("establishment_id")
  partnerId       String?             @map("partner_id")
  reason          String
  status          TwentySyncJobStatus @default(PENDING)
  attempts        Int                 @default(0)
  nextRunAt       DateTime            @default(now()) @map("next_run_at")
  lastError       String?             @map("last_error")
  lastErrorAt     DateTime?           @map("last_error_at")
  completedAt     DateTime?           @map("completed_at")
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  @@index([status, nextRunAt])
  @@index([establishmentId])
  @@index([createdAt(sort: Desc)])
  @@map("twenty_sync_jobs")
}

model TwentySyncMetadata {
  id                          String    @id @default("singleton")
  initialMigrationCompleted   Boolean   @default(false) @map("initial_migration_completed")
  initialMigrationStartedAt   DateTime? @map("initial_migration_started_at")
  initialMigrationCompletedAt DateTime? @map("initial_migration_completed_at")
  totalRecordsMigrated        Int       @default(0) @map("total_records_migrated")
  lastMigrationError          String?   @map("last_migration_error")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  @@map("twenty_sync_metadata")
}

model ElevenLabsPersonality {
  id        String          @id @default(uuid())
  name      String          @unique
  voiceId   String          @map("voice_id")
  agentId   String?         @map("agent_id")
  isActive  Boolean         @default(true) @map("is_active")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  variants  AbTestVariant[]

  @@map("elevenlabs_personalities")
}

model AbTest {
  id          String          @id @default(uuid())
  name        String
  description String?
  agentType   String          @map("agent_type")
  status      String          @default("DRAFT")
  startDate   DateTime?       @map("start_date")
  endDate     DateTime?       @map("end_date")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  createdBy   String?         @map("created_by")
  variants    AbTestVariant[]

  @@index([createdBy])
  @@map("ab_tests")
}

model AbTestVariant {
  id             String                 @id @default(uuid())
  abTestId       String                 @map("ab_test_id")
  agentConfigId  String?                @map("agent_config_id")
  voiceId        String?                @map("voice_id")
  percentage     Int
  totalCalls     Int                    @default(0) @map("total_calls")
  totalConnected Int                    @default(0) @map("total_connected")
  totalConverted Int                    @default(0) @map("total_converted")
  voiceName      String?                @map("voice_name")
  personalityId  String?                @map("personality_id")
  contacts       AbTestContact[]
  abTest         AbTest                 @relation(fields: [abTestId], references: [id], onDelete: Cascade)
  personality    ElevenLabsPersonality? @relation(fields: [personalityId], references: [id])

  @@map("ab_test_variants")
}

model AbTestContact {
  id              String        @id @default(uuid())
  abTestVariantId String        @map("ab_test_variant_id")
  contactId       String        @map("contact_id")
  contactType     String        @default("ESTABLISHMENT")
  status          String        @default("PENDING")
  result          String?
  calledAt        DateTime?     @map("called_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  variant         AbTestVariant @relation(fields: [abTestVariantId], references: [id], onDelete: Cascade)

  @@map("ab_test_contacts")
}

model AbTestCandidate {
  establishmentId   String   @unique @map("establishment_id")
  userId            String?  @map("user_id")
  createdAt         DateTime @default(now()) @map("created_at")
  id                String   @id @default(uuid())
  snapshotName      String?  @map("snapshot_name")
  snapshotPhone     String?  @map("snapshot_phone")
  snapshotUbicacion String?  @map("snapshot_ubicacion")

  @@map("ab_test_candidates")
}

model OnboardingInteraction {
  id               String   @id @default(uuid())
  establishmentId  String   @map("establishment_id")
  agentId          String?  @map("agent_id")
  conversationId   String?  @map("conversation_id")
  customerName     String?  @map("customer_name")
  businessName     String?  @map("business_name")
  phone            String?
  currentStep      String?  @map("current_step")
  issueDescription String?  @map("issue_description")
  callStatus       String?  @map("call_status")
  summary          String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  @@index([establishmentId])
  @@index([conversationId])
  @@map("onboarding_interactions")
}

