{
  "name": "easyorder-partners-api",
  "version": "1.0.0",
  "description": "Backend API para el sistema de partners de EasyOrder",
  "main": "src/app.js",
  "scripts": {
    "build": "prisma generate && prisma generate --schema=prisma/schema-geo.prisma",
    "postinstall": "prisma generate && prisma generate --schema=prisma/schema-geo.prisma",
    "start": "node src/app.js",
    "start:workers": "node src/startWorkers.js",
    "dev": "nodemon src/app.js",
    "db:generate": "prisma generate && prisma generate --schema=prisma/schema-geo.prisma",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "node prisma/seed.js",
    "seed:emails": "node prisma/seed-email-templates.js",
    "redis:check": "node scripts/checkRedis.js",
    "test:integration": "node tests/integration/queue-system.test.js",
    "test:integration:watch": "nodemon tests/integration/queue-system.test.js"
  },
  "keywords": [
    "partners",
    "api",
    "easyorder"
  ],
  "author": "EasyOrder",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/lib-storage": "^3.943.0",
    "@bull-board/api": "^6.18.2",
    "@bull-board/express": "^6.18.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.5",
    "cors": "^2.8.5",
    "csv-stringify": "^6.6.0",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "helmet": "^7.1.0",
    "iconv-lite": "^0.7.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "pdfkit": "^0.17.2",
    "prisma": "^5.22.0",
    "resend": "^6.5.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.1",
    "uuid": "^9.0.1",
    "winston": "^3.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/uuid": "^9.0.8",
    "dotenv": "^17.2.3",
    "nodemon": "^3.1.0"
  }
}
